# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# local storage fallback (used when Supabase Storage isn't configured)
/.local-storage/

# typescript
*.tsbuildinfo
next-env.d.ts

# raw manually-collected CFM registry data for scripts/import-verified-doctors.ts
# (real doctor names/CRMs — loaded into the database, not meant to live in git history)
dados.txt
dados*.txt
/data/cfm-raw/
