# ============================================================================
# MedCheck — Environment variables
# Copy this file to .env and fill in the values. See README.md for the full
# Supabase setup walkthrough (project creation, connection strings, buckets).
# ============================================================================

# --- Database (Supabase Postgres) -------------------------------------------
# Pooled connection (pgbouncer, port 6543) — used by the app at runtime.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) — used by Prisma Migrate.
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# --- Supabase ----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_STORAGE_BUCKET="medical-certificates"
SUPABASE_STORAGE_BUCKET_EVIDENCE="evidence-files"
SUPABASE_STORAGE_BUCKET_REPORTS="reports"

# --- Auth ---------------------------------------------------------------------
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# --- WhatsApp Business (per-organization, configured at /admin/whatsapp) -----
# Provider/phoneNumberId/token are set per organization in that page, not via
# env vars. META_CLOUD_API is the only real adapter (real Graph API calls,
# see adapters/meta-whatsapp.adapter.ts); TWILIO/GENERIC remain SIMULATED
# stubs (see the other adapters/ files) until a real integration is built
# for those providers. WHATSAPP_VERIFY_TOKEN below must match the value
# entered in Meta's webhook setup — it's the handshake secret for the
# GET verification request, not a per-organization value.
WHATSAPP_VERIFY_TOKEN="medcheck-verify-token"

# --- Secrets encryption (per-organization tokens, e.g. WhatsApp access token) -
# Generate with `openssl rand -hex 32` (32 bytes / 64 hex chars, required).
# MUST be the exact same value in every environment that touches this
# database (local dev and Vercel share one Supabase instance here, not
# separate per-environment databases) — whatever encrypted a value can only
# be decrypted with that same key, so a mismatched key between local and
# production breaks any secret written from the other side.
SECRETS_ENCRYPTION_KEY=""

# --- Email notifications (via Resend) -----------------------------------------
# Without both of these, email notifications honestly report SIMULATED
# (Notification.status) instead of a fabricated SENT — see
# adapters/resend-email.adapter.ts. EMAIL_FROM_ADDRESS must be on a domain
# verified in Resend (SPF/DKIM DNS records added at your DNS provider).
RESEND_API_KEY=""
EMAIL_FROM_ADDRESS="MedCheck <medcheck@francotech.com.br>"

# --- Webhooks -------------------------------------------------------------------
WEBHOOK_SECRET="generate-a-long-random-string"

# --- Feature toggles (mock vs real integrations) ------------------------------
# Doctor CRM verification has no on/off switch: it always checks the
# VerifiedDoctor cache (doctors a staff member confirmed by hand against
# CFM's own site) first, then falls back to CRM/UF format plausibility only
# — it never fabricates a confirmation. No CFM public API exists to plug in
# yet; see README "Como plugar validação de CRM".
#
# Clinic/CNPJ verification also has no switch — it always queries the real,
# free Receita Federal CNPJ registry via BrasilAPI (no key required).

# --- AI-generated image / deepfake detection (Phase 2 — optional) ------------
# Leave AI_DETECTION_PROVIDER unset/"NONE" to keep using the free metadata-only
# heuristic. Set to "SIGHTENGINE" and fill in the two keys below (from
# https://dashboard.sightengine.com) to enable real statistical detection.
AI_DETECTION_PROVIDER="NONE"
SIGHTENGINE_API_USER=""
SIGHTENGINE_API_SECRET=""

# --- Document extraction — real OCR + structured extraction (Phase 3) --------
# Leave EXTRACTION_PROVIDER unset/"MOCK" to keep the old randomized mock
# extraction (never reads the actual file). Set to "CLAUDE_VISION" and provide
# an Anthropic API key (from https://console.anthropic.com) to have Claude
# Sonnet 5 read the uploaded document directly and extract real structured
# fields plus content-authenticity observations.
EXTRACTION_PROVIDER="MOCK"
ANTHROPIC_API_KEY=""
